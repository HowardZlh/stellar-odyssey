# GitHub 账号钉定：本仓库 gh / git push 一律走 HowardZlh（本机可能同时登录多个 gh 账号）。
#
# 实际生效靠 .git/config（不随 clone 走）+ ~/.zshenv 里按 `git config gh.configDir`
# 切 GH_CONFIG_DIR 的 gh 包装函数。新机器 clone 后按下面三步重做一次：
#
#   # 1 独立 gh 配置目录（复用已登录 token，无需浏览器；目录已存在则跳过）
#   mkdir -p ~/.config/gh-howardzlh
#   gh auth token -u HowardZlh | GH_CONFIG_DIR=~/.config/gh-howardzlh gh auth login --with-token
#   # 2 gh 包装函数开关
#   git config --local gh.configDir '~/.config/gh-howardzlh'
#   # 3 git 凭证钉死（空 helper 先清掉系统 osxkeychain）
#   git remote set-url origin https://HowardZlh@github.com/HowardZlh/stellar-odyssey.git
#   git config --local credential.helper '' \
#     && git config --local --add credential.helper '!GH_CONFIG_DIR=$HOME/.config/gh-howardzlh gh auth git-credential'
#
# 验证：`gh api user -q .login` 与 `printf 'protocol=https\nhost=github.com\n' | git credential fill`
# 都应给出 HowardZlh。

# direnv 用户：进入目录即切 gh 配置目录（未装 direnv 可忽略本文件）
export GH_CONFIG_DIR="$HOME/.config/gh-howardzlh"
